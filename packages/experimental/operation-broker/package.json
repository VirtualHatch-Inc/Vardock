{
  "name": "@deepseek-ai/dsh-operation-broker",
  "description": "Dispatch approved HTTPS JSON operations through fixed authority routes",
  "version": "0.2.2-rc.5",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VirtualHatch-Inc/Vardock.git",
    "directory": "packages/experimental/operation-broker"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./mcp": {
      "types": "./lib/types/mcp.d.ts",
      "default": "./lib/mcp.js"
    },
    "./library": {
      "types": "./lib/types/library.d.ts",
      "default": "./lib/library.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/mcp.js",
    "lib/library.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "undici": "8.11.2",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-mcp-client": "workspace:*",
    "@deepseek-ai/dsh-timeout": "workspace:*",
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/dsh-http-proxy": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.2.0",
    "selfsigned": "^4.0.1",
    "zod": "4.6.6"
  }
}
