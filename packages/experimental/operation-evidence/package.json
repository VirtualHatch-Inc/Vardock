{
  "name": "@deepseek-ai/dsh-operation-evidence",
  "description": "Preserve execution evidence under a separate service account",
  "version": "0.2.2-rc.5",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VirtualHatch-Inc/Vardock.git",
    "directory": "packages/experimental/operation-evidence"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./library": {
      "types": "./lib/types/library.d.ts",
      "default": "./lib/library.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/library.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-timeout": "workspace:*",
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "@deepseek-ai/node-addon-system": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
