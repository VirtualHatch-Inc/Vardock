{
  "name": "@deepseek-ai/dsh-operation-control",
  "description": "Authorize isolated shell and Local Codex operations through a separate local authority",
  "version": "0.2.2-rc.5",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VirtualHatch-Inc/Vardock.git",
    "directory": "packages/experimental/operation-control"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./agent": {
      "types": "./lib/types/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./model-agent": {
      "types": "./lib/types/model-agent.d.ts",
      "default": "./lib/model-agent.js"
    },
    "./library": {
      "types": "./lib/types/library.d.ts",
      "default": "./lib/library.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./handoff": {
      "types": "./lib/types/handoff.d.ts",
      "default": "./lib/handoff.js"
    },
    "./types": {
      "types": "./lib/types/ids.d.ts"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/agent.js",
    "lib/model-agent.js",
    "lib/handoff.js",
    "lib/library.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-execution-container": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-operation-broker": "workspace:*",
    "@deepseek-ai/dsh-operation-evidence": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-timeout": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-loader-smoke": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tool-executor-native": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-user-approval": "workspace:*",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.2.0"
  }
}
